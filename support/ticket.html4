<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon ticket - ValoriaRP</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Roboto, sans-serif; background: #0b0a0a; color: #f5f0e6; padding: 1rem; min-height: 100vh; }

        /* Notification style erreur */
        .notif {
            position: fixed; top: 1rem; left: 1rem;
            background: #2a0f0f; border: 1px solid #a83232;
            border-left: 4px solid #ff4d4d;
            color: #ffd6d6; padding: 0.8rem 2.5rem 0.8rem 1rem;
            border-radius: 10px; font-size: 0.9rem;
            z-index: 1000; display: flex; align-items: center; gap: 0.7rem;
            box-shadow: 0 4px 15px rgba(168, 50, 50, 0.3);
            animation: slideIn 0.4s ease;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .notif .icone {
            width: 22px; height: 22px; min-width: 22px;
            background: #ff4d4d; color: #fff;
            border-radius: 50%; display: flex;
            align-items: center; justify-content: center;
            font-weight: bold; font-size: 0.9rem;
        }
        .notif .contenu { display: flex; flex-direction: column; }
        .notif .titre { font-weight: bold; color: #ff8a8a; font-size: 0.85rem; }
        .notif .desc { color: #ffd6d6; font-size: 0.8rem; }
        .notif .fermer {
            position: absolute; top: 0.5rem; right: 0.6rem;
            background: transparent; border: none;
            color: #ff8a8a; font-size: 1.1rem; cursor: pointer;
            line-height: 1; padding: 0;
        }
        .notif .fermer:hover { color: #fff; }

        .container {
            max-width: 800px; margin: 0 auto;
            background: #14110e; border: 1px solid #3f3423;
            border-radius: 20px; padding: 1.5rem;
            display: flex; flex-direction: column;
            height: calc(100vh - 2rem);
        }
        h1 { color: #e8d6a8; margin-bottom: 1rem; font-size: 1.3rem; }
        .messages {
            flex: 1; background: #0b0a0a; border-radius: 12px;
            padding: 1rem; overflow-y: auto; margin: 1rem 0;
            border: 1px solid #2a241e;
            display: flex; align-items: center; justify-content: center;
        }
        .indisponible {
            text-align: center; color: #b8a582; font-size: 1.1rem;
            font-style: italic; padding: 2rem;
        }
        .input-row { display: flex; gap: 0.5rem; }
        .input-row input {
            flex: 1; padding: 0.8rem; border-radius: 10px;
            border: 1px solid #3f3423; background: #1f1b16;
            color: #6b6258; font-size: 1rem; cursor: not-allowed;
        }
        .input-row button {
            padding: 0.8rem 1.5rem; border: none; border-radius: 10px;
            background: #3a3a3a; color: #8a8a8a; font-weight: bold;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <div class="notif" id="notif">
        <div class="icone">!</div>
        <div class="contenu">
            <div class="titre">Serveur fermé</div>
            <div class="desc">Les tickets ne sont plus disponibles.</div>
        </div>
        <button class="fermer" onclick="document.getElementById('notif').style.display='none'">✕</button>
    </div>

    <div class="container">
        <h1 id="titre">🎫 Mon ticket</h1>
        <div class="messages" id="messages">
            <div class="indisponible">Les tickets ne sont plus disponibles car le serveur a fermé ses portes. Merci d'avoir joué sur ValoriaRP.</div>
        </div>
        <div class="input-row">
            <input type="text" id="msg-input" placeholder="Non disponible..." disabled>
            <button disabled>Non Disponible</button>
        </div>
    </div>

</body>
</html>
